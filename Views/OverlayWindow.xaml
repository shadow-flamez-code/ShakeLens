<Window x:Class="ShakeLens.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShakeLens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid x:Name="Root">

    <!-- the frozen screen -->
    <Image x:Name="ScreenImage" Stretch="Fill" SnapsToDevicePixels="True" />

    <!-- the scrim -->
    <Rectangle x:Name="Scrim" Fill="{StaticResource ScrimBrush}" />

    <!-- the selected area keeps its brightness -->
    <Image x:Name="SelectionImage" Stretch="Fill" Visibility="Collapsed" SnapsToDevicePixels="True" />

    <!-- breathing glow -->
    <Border x:Name="GlowBorder" Visibility="Collapsed" CornerRadius="16"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            BorderThickness="7" BorderBrush="{StaticResource AccentBrush}"
            Background="Transparent" Opacity="0.35" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#4C8DFF" Opacity="0.85" />
      </Border.Effect>
    </Border>

    <!-- crisp frame -->
    <Border x:Name="SelectionBorder" Visibility="Collapsed" CornerRadius="11"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            BorderThickness="2" BorderBrush="{StaticResource AccentSoftBrush}"
            Background="Transparent" IsHitTestVisible="False" />

    <!-- hint chip -->
    <Border x:Name="HintChip" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0"
            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="1" CornerRadius="21" Padding="20,11" Effect="{StaticResource PanelShadow}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock Text="Drag to select an area" Foreground="{StaticResource TextBrush}"
                   FontSize="13.5" VerticalAlignment="Center" />
        <TextBlock Text="·" Foreground="{StaticResource TextDimBrush}" Margin="10,0"
                   VerticalAlignment="Center" />
        <TextBlock Text="Esc to cancel" Foreground="{StaticResource TextDimBrush}"
                   FontSize="13.5" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- action toolbar -->
    <Border x:Name="Toolbar" Visibility="Collapsed" HorizontalAlignment="Left"
            VerticalAlignment="Top" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16"
            Padding="8" Effect="{StaticResource PanelShadow}">
      <Border.RenderTransform>
        <TranslateTransform x:Name="ToolbarSlide" Y="12" />
      </Border.RenderTransform>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="LensButton" Style="{StaticResource PrimaryButton}" Click="OnLensClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock Text="Search with Google Lens" Foreground="White" FontSize="13.5"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Rectangle Width="1" Margin="8,9" Fill="{StaticResource OutlineBrush}" />

        <Button x:Name="CopyTextButton" Style="{StaticResource IconButton}" Click="OnCopyTextClick"
                ToolTip="Copy the text inside the selection">
          <TextBlock Text="&#xE8D2;" Style="{StaticResource Glyph}" />
        </Button>
        <Button x:Name="CopyImageButton" Style="{StaticResource IconButton}" Click="OnCopyImageClick"
                ToolTip="Copy the selection as an image">
          <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" />
        </Button>
        <Button x:Name="AskAiButton" Style="{StaticResource IconButton}" Click="OnAskAiClick"
                ToolTip="Ask an AI about the selection">
          <TextBlock Text="&#xE99A;" Style="{StaticResource Glyph}" />
        </Button>

        <Rectangle Width="1" Margin="8,9" Fill="{StaticResource OutlineBrush}" />

        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Click="OnCloseClick"
                ToolTip="Cancel">
          <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" Foreground="{StaticResource TextDimBrush}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- toast -->
    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center"
            VerticalAlignment="Bottom" Margin="0,0,0,64"
            Background="{StaticResource AccentBrush}" CornerRadius="20" Padding="22,11">
      <TextBlock x:Name="ToastText" Foreground="White" FontSize="13.5" FontWeight="SemiBold" />
    </Border>

  </Grid>
</Window>
