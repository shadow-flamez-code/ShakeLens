<Window x:Class="ShakeLens.Views.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShakeLens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

  <Border x:Name="Panel" Background="{StaticResource SurfaceBrush}" CornerRadius="16"
          BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
          Margin="18" Effect="{StaticResource PanelShadow}">
    <Border.RenderTransform>
      <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
    </Border.RenderTransform>
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- header -->
      <Grid Grid.Row="0" Margin="20,16,12,10">
        <TextBlock x:Name="TitleText" Foreground="{StaticResource TextBrush}" FontSize="15"
                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,44,0"
                   TextTrimming="CharacterEllipsis" />
        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCloseClick">
          <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"
                     Foreground="{StaticResource TextDimBrush}" />
        </Button>
      </Grid>

      <!-- body -->
      <Border Grid.Row="1" Margin="20,0,20,0" Background="#151922" CornerRadius="10"
              BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10" MaxHeight="340">
          <TextBlock x:Name="BodyText" Foreground="{StaticResource TextBrush}" FontSize="13.5"
                     TextWrapping="Wrap" LineHeight="20" />
        </ScrollViewer>
      </Border>

      <!-- footer -->
      <Grid Grid.Row="2" Margin="20,14,20,16">
        <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Height="36"
                HorizontalAlignment="Left" Click="OnCopyClick">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Copy" Foreground="White" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>
  </Border>
</Window>
