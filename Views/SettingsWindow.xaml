<Window x:Class="ShakeLens.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShakeLens"
        Width="520"
        Height="620"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#12151C"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#1A1F29" />
      <Setter Property="BorderBrush" Value="#272D3A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="auto" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{StaticResource SurfaceHighBrush}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource OutlineBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="26,24,26,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ header ============================ -->
    <StackPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentBrush}">
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="ShakeLens" Foreground="{StaticResource TextBrush}" FontSize="19"
                     FontWeight="SemiBold" />
          <TextBlock Text="Shake the mouse or press Win+Shift+G, then drag out an area."
                     Foreground="{StaticResource TextDimBrush}" FontSize="12.5" Margin="0,3,0,0" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- ============================ content =========================== -->
    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,0">
      <StackPanel>

        <!-- gesture -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="GESTURE" Foreground="{StaticResource AccentSoftBrush}" FontSize="11"
                       FontWeight="SemiBold" Margin="0,0,0,14" />

            <CheckBox x:Name="ShakeEnabled" Style="{StaticResource Switch}"
                      Content="React when the cursor is shaken" />

            <Grid Style="{StaticResource Row}" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Sensitivity" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                <TextBlock Text="How hard the mouse has to be shaken" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox x:Name="Sensitivity" Grid.Column="1" Width="150" VerticalAlignment="Center">
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Balanced" />
                <ComboBoxItem Content="Strict" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- lens -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="GOOGLE LENS" Foreground="{StaticResource AccentSoftBrush}" FontSize="11"
                       FontWeight="SemiBold" Margin="0,0,0,14" />

            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Result language" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                <TextBlock Text="Language of the Lens page" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox x:Name="LensLanguage" Grid.Column="1" Width="170" VerticalAlignment="Center" />
            </Grid>

            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Browser" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                <TextBlock Text="Where the result page opens" Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox x:Name="Browser" Grid.Column="1" Width="170" VerticalAlignment="Center">
                <ComboBoxItem Content="Default" />
                <ComboBoxItem Content="Chrome" />
                <ComboBoxItem Content="Edge" />
                <ComboBoxItem Content="Firefox" />
              </ComboBox>
            </Grid>

            <Grid Style="{StaticResource Row}" Margin="0,0,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Max upload size" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                <TextBlock Text="Longest edge of the picture sent to Lens"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox x:Name="UploadSize" Grid.Column="1" Width="170" VerticalAlignment="Center">
                <ComboBoxItem Content="1000 px" />
                <ComboBoxItem Content="1400 px" />
                <ComboBoxItem Content="2000 px" />
                <ComboBoxItem Content="2560 px" />
              </ComboBox>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ai -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="ASK AI" Foreground="{StaticResource AccentSoftBrush}" FontSize="11"
                       FontWeight="SemiBold" Margin="0,0,0,14" />

            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Provider" Foreground="{StaticResource TextBrush}" FontSize="13.5" />
                <TextBlock Text="Free keys: Google AI Studio, OpenAI, Anthropic"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,2,0,0" />
              </StackPanel>
              <ComboBox x:Name="Provider" Grid.Column="1" Width="170" VerticalAlignment="Center">
                <ComboBoxItem Content="None" />
                <ComboBoxItem Content="Gemini" />
                <ComboBoxItem Content="OpenAI" />
                <ComboBoxItem Content="Claude" />
              </ComboBox>
            </Grid>

            <TextBlock Text="API key" Foreground="{StaticResource TextDimBrush}" FontSize="12.5"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ApiKey" />

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Model" Foreground="{StaticResource TextDimBrush}" FontSize="12.5" />
              </StackPanel>
              <TextBox x:Name="Model" Grid.Column="1" Width="170" />
            </Grid>

            <TextBlock Text="Prompt" Foreground="{StaticResource TextDimBrush}" FontSize="12.5"
                       Margin="0,16,0,6" />
            <TextBox x:Name="Prompt" Height="78" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </Border>

        <!-- system -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="SYSTEM" Foreground="{StaticResource AccentSoftBrush}" FontSize="11"
                       FontWeight="SemiBold" Margin="0,0,0,14" />
            <CheckBox x:Name="AutoStart" Style="{StaticResource Switch}" Content="Start with Windows" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ============================ footer ============================ -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
              Height="38" Margin="0,0,10,0" Click="OnSaveClick" />
      <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
