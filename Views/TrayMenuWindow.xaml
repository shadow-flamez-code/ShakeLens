<Window x:Class="ShakeLens.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShakeLens"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Focusable="False"
        UseLayoutRounding="True">

  <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
          BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
          Padding="6" Effect="{StaticResource PanelShadow}">
    <StackPanel x:Name="Items" MinWidth="236">
    </StackPanel>
  </Border>
</Window>
